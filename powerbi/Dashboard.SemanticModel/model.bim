        "measures": [
          {
            "name": "Contact Records",
            "expression": "COUNTROWS(FactCampaign)",
            "formatString": "#,0",
            "displayFolder": "Performance",
            "description": "Contact Records. Format: #,0. Definition: COUNTROWS(FactCampaign). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "acea453c-d305-5eab-8eea-497cc6e9eef0"
          },
          {
            "name": "Subscriptions",
            "expression": "SUM(FactCampaign[Subscribed])",
            "formatString": "#,0",
            "displayFolder": "Performance",
            "description": "Subscriptions. Format: #,0. Definition: SUM(FactCampaign[Subscribed]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "bbcafeac-e47e-51cd-b265-6abc2404ae28"
          },
          {
            "name": "Conversion Rate",
            "expression": "DIVIDE([Subscriptions], [Contact Records])",
            "formatString": "0.0%",
