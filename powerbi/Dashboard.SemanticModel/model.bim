            "lineageTag": "b355ede9-5c15-5a7f-bad7-a79a92e1383a"
          },
          {
            "name": "Average Prior Gap Days",
            "expression": "AVERAGE(FactCampaign[DaysSincePrevious])",
            "formatString": "0.0",
            "displayFolder": "Performance",
            "description": "Average Prior Gap Days. Format: 0.0. Definition: AVERAGE(FactCampaign[DaysSincePrevious]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "14b8819e-475c-5147-99cc-9c351e0a6893"
          },
          {
            "name": "Conversion CI Lower",
            "expression": "VAR N = [Contact Records] VAR P = [Conversion Rate] VAR Z = 1.96 RETURN IF(N > 0, DIVIDE(P + Z*Z/(2*N) - Z*SQRT(DIVIDE(P*(1-P),N) + Z*Z/(4*N*N)), 1+Z*Z/N))",
            "formatString": "0.0%",
            "displayFolder": "Uncertainty",
            "description": "Conversion CI Lower. Format: 0.0%. Definition: VAR N = [Contact Records] VAR P = [Conversion Rate] VAR Z = 1.96 RETURN IF(N > 0, DIVIDE(P + Z*Z/(2*N) - Z*SQRT(DIVIDE(P*(1-P),N) + Z*Z/(4*N*N)), 1+Z*Z/N)). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "9c721d6a-021d-598a-8b6d-587e0324f6bc"
          },
          {
            "name": "Conversion CI Upper",
            "expression": "VAR N = [Contact Records] VAR P = [Conversion Rate] VAR Z = 1.96 RETURN IF(N > 0, DIVIDE(P + Z*Z/(2*N) + Z*SQRT(DIVIDE(P*(1-P),N) + Z*Z/(4*N*N)), 1+Z*Z/N))",
            "formatString": "0.0%",
            "displayFolder": "Uncertainty",
            "description": "Conversion CI Upper. Format: 0.0%. Definition: VAR N = [Contact Records] VAR P = [Conversion Rate] VAR Z = 1.96 RETURN IF(N > 0, DIVIDE(P + Z*Z/(2*N) + Z*SQRT(DIVIDE(P*(1-P),N) + Z*Z/(4*N*N)), 1+Z*Z/N)). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "e8a12015-7940-5279-af28-374f5e351405"
