            "lineageTag": "7ebfcbf6-6b3c-5e74-8c25-e24f92ca74ab"
          },
          {
            "name": "Previously Contacted Share",
            "expression": "DIVIDE([Previously Contacted Records], [Contact Records])",
            "formatString": "0.0%",
            "displayFolder": "Performance",
            "description": "Previously Contacted Share. Format: 0.0%. Definition: DIVIDE([Previously Contacted Records], [Contact Records]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "6381be1d-4971-5726-bda5-70d0a5115aff"
          },
          {
            "name": "Not Recorded Records",
            "expression": "SUM(FactCampaign[HasUnknown])",
            "formatString": "#,0",
            "displayFolder": "Quality and coverage",
            "description": "Not Recorded Records. Format: #,0. Definition: SUM(FactCampaign[HasUnknown]). See docs/METRIC_CONTRACT.md for denominator and interpretation limits.",
            "lineageTag": "ca6bd80a-750c-520c-9845-aba0dadf4356"
          },
